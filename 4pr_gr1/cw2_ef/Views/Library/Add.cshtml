@model Book

<h3>Dodawanie książki</h3>
<form asp-action="Add" method="post">
    <div class="mb-3">
        <label for="Title" class="form-label">Tytuł</label>
        <input type="text" class="form-control" id="Title" asp-for="Title" required>
    </div>
    <div class="mb-3">
        <label for="Author" class="form-label">Autor</label>
        <input type="text" class="form-control" id="Author" asp-for="Author" required>
    </div>
    <div class="mb-3">
        <label for="Year" class="form-label">Rok wydania</label>
        <input type="number" class="form-control" id="Year" asp-for="Year" required>
    </div>
    <div class="mb-3">
        <label for="Price" class="form-label">Cena</label>
        <input type="number" step="0.01" class="form-control" id="Price" asp-for="Price" required>
    </div>
    <button type="submit" class="btn btn-primary">Dodaj książkę</button>
</form>