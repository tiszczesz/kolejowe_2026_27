@model IEnumerable<cw2_ef.Models.Book>
<h3>Lista książek</h3>
<table class="table table-striped">
<thead>
    <tr>
        <th>Tytuł</th>
        <th>Autor</th>
        <th>Rok wydania</th>
        <th>Cena</th>
        <th> --- </th>
    </tr>
</thead>
<tbody>
    @foreach (var book in Model)
    {
        <tr>
            <td>@book.Title</td>
            <td>@book.Author</td>
            <td>@book.Year</td>
            <td>@book.Price</td>
            <td>
                <a href="@Url.Action("Edit", "Library", new { id = book.Id })" class="btn btn-sm btn-outline-primary">Edytuj</a>
                <a href="@Url.Action("Delete", "Library", new { id = book.Id })" class="btn btn-sm btn-outline-danger">Usuń</a>
            </td>
        </tr>
    }
</tbody>
