@model IEnumerable<cw2_ef.Models.Book>
<h3>Lista książek</h3>
<table class="table table-striped">
<thead>
    <tr>
        <th>Tytuł</th>
        <th>Autor</th>
        <th>Rok wydania</th>
        <th>Cena</th>
    </tr>
</thead>
<tbody>
    @foreach (var book in Model)
    {
        <tr>
            <td>@book.Title</td>
            <td>@book.Author</td>
            <td>@book.Year</td>
            <td>@book.Price</td>
        </tr>
    }
</tbody>
