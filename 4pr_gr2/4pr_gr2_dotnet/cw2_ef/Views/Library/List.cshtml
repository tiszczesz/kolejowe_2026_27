@model List<Movie>

<h3>Lista filmów</h3>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Tytuł</th>
            <th>Reżyser</th>
            <th>Data wydania</th>
            <th> ----</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var movie in Model)
        {
            <tr>
                <td>@movie.Title</td>
                <td>@movie.Director</td>
                <td>@movie.ReleaseDate</td>
                <td>
                    <a asp-action="Delete" asp-route-id="@movie.Id">Usuń</a>
                    &nbsp;|&nbsp;
                    <a asp-action="Edit" asp-route-id="@movie.Id">Edytuj</a>
                </td>
            </tr>
        }
    </tbody>
</table>