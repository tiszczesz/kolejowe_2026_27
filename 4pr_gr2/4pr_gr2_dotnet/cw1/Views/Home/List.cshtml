@model IEnumerable<cw1.Models.Item>
<h3>Lista sprzętu do wypożyczenia</h3>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Nazwa</th>
            <th>Opis</th>
            <th>Cena za godzinę</th>
            <th>Akcje</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Description</td>
                <td>@item.Price.ToString("C")</td>
                <td>
                    <a class="btn btn-primary" asp-action="Rental" asp-route-id="@item.Id">Wypożycz</a>
                </td>
            </tr>
        }
    </tbody>
</table>